---
import { getEmDashEntry, getEmDashCollection, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Eyebrow from "../../components/site/Eyebrow.astro";
import PostCardGrid from "../../components/site/PostCardGrid.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { estimateReadingMinutes } from "../../utils/reading-time";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];

const publishedLabel = post.data.publishedAt
	? post.data.publishedAt.toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: null;

const { entries: recent } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 4,
});

const related = recent
	.filter((p) => p.id !== post.id)
	.slice(0, 3)
	.map((p) => ({
		title: p.data.title,
		href: `/posts/${p.id}`,
		image: p.data.featured_image,
		date: p.data.publishedAt
			? p.data.publishedAt.toLocaleDateString("en-US", {
					year: "numeric",
					month: "long",
					day: "numeric",
				})
			: null,
		readTime: `${estimateReadingMinutes(p.data.content)} min read`,
	}));
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="post">
		<div class="post__header">
			{categories.length > 0 && <Eyebrow tone="accent">{categories[0].label}</Eyebrow>}
			<h1 {...post.edit.title}>{post.data.title}</h1>
		</div>

		{
			post.data.featured_image && (
				<div class="post__image" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</div>
			)
		}

		<div class="post__byline">
			{post.data.byline && (
				<span>
					Written by <strong>{post.data.byline.displayName}</strong>
				</span>
			)}
			{publishedLabel && <span>Published {publishedLabel}</span>}
		</div>

		<div class="post__body">
			<PortableText value={post.data.content} />
		</div>

		{
			tags.length > 0 && (
				<div class="post__tags">
					{tags.map((t) => (
						<a href={`/tag/${t.slug}`}>{t.label}</a>
					))}
				</div>
			)
		}
	</article>

	{
		related.length > 0 && (
			<section class="post__related">
				<div class="post__related-inner">
					<PostCardGrid items={related} />
				</div>
			</section>
		)
	}
</Base>

<style>
	.post {
		max-width: 42rem;
		margin: 0 auto;
		padding: var(--section-pad-y) var(--gutter) 3rem;
	}

	.post__header h1 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-h1);
		line-height: var(--leading-tight);
		margin: 0.75rem 0 0;
	}

	.post__image {
		margin: 2.5rem 0;
		border-radius: var(--radius-card);
		overflow: hidden;
	}

	.post__image :global(img) {
		width: 100%;
		display: block;
	}

	.post__byline {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		justify-content: space-between;
		font-size: var(--text-small);
		color: var(--color-text-muted);
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-line);
		margin-bottom: 2rem;
	}

	.post__byline strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.post__body {
		font-size: var(--text-body);
		line-height: var(--leading-normal);
		color: var(--color-text);
	}

	.post__body :global(h2) {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-h2);
		margin: 2rem 0 1rem;
	}

	.post__body :global(p) {
		margin: 0 0 1.25rem;
	}

	.post__tags {
		display: flex;
		gap: 0.5rem;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-line);
	}

	.post__tags a {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
		color: var(--color-text-muted);
		text-decoration: none;
		border: 1px solid var(--color-line);
		border-radius: 999px;
		padding: 0.35rem 0.75rem;
	}

	.post__tags a:hover {
		color: var(--color-text);
	}

	.post__related {
		border-top: 1px solid var(--color-line);
		padding: var(--section-pad-y) var(--gutter);
	}

	.post__related-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}
</style>
