---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Blocks, PortableText, defineBlockComponents } from "emdash/ui";
import type { PageLayoutBlock } from "../../emdash-env";
import Base from "../layouts/Base.astro";
import Testimonials from "../components/blocks/Testimonials.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const blockComponents = defineBlockComponents<PageLayoutBlock>({
	testimonials: Testimonials,
});

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="page">
		<h1 {...page.edit.title}>{page.data.title}</h1>
		<div class="page__body">
			<PortableText value={page.data.content} />
		</div>
	</article>

	<Blocks value={page.data.layout} components={blockComponents} />
</Base>

<style>
	.page {
		max-width: 42rem;
		margin: 0 auto;
		padding: var(--section-pad-y) var(--gutter);
	}

	.page h1 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-h1);
		line-height: var(--leading-tight);
		margin: 0 0 1.5rem;
	}

	.page__body {
		font-size: var(--text-body);
		line-height: var(--leading-normal);
		color: var(--color-text);
	}

	.page__body :global(h2) {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-h2);
		margin: 2rem 0 1rem;
	}

	.page__body :global(p) {
		margin: 0 0 1.25rem;
	}
</style>
