---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Blocks } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PageTitle from "../components/site/PageTitle.astro";
import { blockComponents, startsWithHero } from "../utils/block-components";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

// The CMS home page is served at "/"; keep one canonical URL.
if (slug === "home") {
	return Astro.redirect("/", 301);
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const heroFirst = startsWithHero(page.data.layout);

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
	overlayHeader={heroFirst}
>
	{!heroFirst && <PageTitle title={page.data.title} edit={page.edit.title} settings={page.data} />}

	<Blocks value={page.data.layout} components={blockComponents} />
</Base>
