---
// Matches uploads/"we begin understanding your goals.png": dark section,
// big headline, pill CTA, then a horizontal-scroll card row (vertical
// scroll drives horizontal translateX) -- not a static grid. Each card
// keeps the small geometric mark (outlined square + filled corner square,
// corner rotates per column).
import { Image } from "emdash/ui";
import type { ImageValue } from "emdash";
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
import { STEP_ICONS, isStepIcon } from "../../utils/step-icons";

interface Pillar {
	title: string;
	description: string;
	/** Preset icon name (see utils/step-icons.ts). */
	icon?: string | null;
	/** Custom uploaded icon (PNG/WebP); wins over the preset. */
	iconImage?: ImageValue | null;
}

interface Props {
	eyebrow?: string | null;
	heading: string;
	description?: string | null;
	ctaLabel?: string | null;
	ctaHref?: string | null;
	items: Pillar[];
}

const { eyebrow, heading, description, ctaLabel, ctaHref, items } = Astro.props;
const corners = ["top-left", "top-right", "bottom-right", "bottom-left"];
---

<section class="goals-intro" data-goals-intro>
	<div class="goals-intro__track" style={`height:${Math.max(items.length * 60, 220)}vh`}>
		<div class="goals-intro__viewport" data-viewport>
			<div class="goals-intro__head">
				{eyebrow && <Eyebrow tone="accent" class="goals-intro__eyebrow">{eyebrow}</Eyebrow>}
				<h2>{heading}</h2>
				{description && <p class="goals-intro__description">{description}</p>}
				{ctaLabel && ctaHref && <Button href={ctaHref} variant="primary">{ctaLabel}</Button>}
			</div>

			<ul class="goals-intro__row" data-row>
				{
					items.map((item, i) => (
						<li class="goals-intro__col" data-col>
							{item.iconImage?.src || item.iconImage?.id ? (
								<span class="goals-intro__icon" aria-hidden="true">
									<Image image={{ ...item.iconImage, alt: "" }} width={44} height={44} />
								</span>
							) : isStepIcon(item.icon) ? (
								<span class="goals-intro__icon" aria-hidden="true">
									<svg
										viewBox="0 0 24 24"
										width="22"
										height="22"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
										set:html={STEP_ICONS[item.icon]}
									/>
								</span>
							) : (
								<span
									class:list={["goals-intro__mark", `goals-intro__mark--${corners[i % corners.length]}`]}
									aria-hidden="true"
								>
									<span />
								</span>
							)}
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</li>
					))
				}
			</ul>

			<div class="goals-intro__rail" aria-hidden="true">
				<div class="goals-intro__rail-line">
					<span class="goals-intro__rail-fill" data-fill />
					{items.map((_, i) => (
						<span class="goals-intro__rail-dot" data-dot style={`left:${items.length > 1 ? (i / (items.length - 1)) * 100 : 0}%`} />
					))}
				</div>
				<span class="goals-intro__rail-count">
					<span data-step>01</span> / {String(items.length).padStart(2, "0")}
				</span>
			</div>
		</div>
	</div>
</section>


<script>
	function initGoalsIntro() {
		const sections = document.querySelectorAll<HTMLElement>("[data-goals-intro]");

		sections.forEach((section) => {
			const track = section.querySelector<HTMLElement>(".goals-intro__track");
			const viewport = section.querySelector<HTMLElement>("[data-viewport]");
			const row = section.querySelector<HTMLElement>("[data-row]");
			if (!track || !viewport || !row) return;
			const cols = Array.from(row.querySelectorAll<HTMLElement>("[data-col]"));
			const dots = Array.from(section.querySelectorAll<HTMLElement>("[data-dot]"));
			const fill = section.querySelector<HTMLElement>("[data-fill]");
			const stepLabel = section.querySelector<HTMLElement>("[data-step]");
			let lastActive = -1;

			const setActive = (active: number) => {
				if (active === lastActive) return;
				lastActive = active;
				cols.forEach((col, i) => {
					col.classList.toggle("is-active", i === active);
					col.classList.toggle("is-passed", i < active);
				});
				dots.forEach((dot, i) => {
					dot.classList.toggle("is-reached", i <= active);
					dot.classList.toggle("is-current", i === active);
				});
				if (stepLabel) stepLabel.textContent = String(active + 1).padStart(2, "0");
			};

			const isNarrow = () => window.matchMedia("(max-width: 780px)").matches;
			let ticking = false;

			const update = () => {
				ticking = false;
				if (isNarrow()) {
					row.style.transform = "";
					section.classList.remove("is-scrubbing");
					return;
				}

				const rect = track.getBoundingClientRect();
				const dwell = Math.max(rect.height - viewport.offsetHeight, 1);
				const scrolled = Math.min(Math.max(-rect.top, 0), dwell);
				const progress = scrolled / dwell;
				const maxScroll = Math.max(row.scrollWidth - viewport.clientWidth, 0);
				row.style.transform = `translateX(${-progress * maxScroll}px)`;

				section.classList.add("is-scrubbing");
				if (fill) fill.style.transform = `scaleX(${progress})`;
				setActive(cols.length > 1 ? Math.round(progress * (cols.length - 1)) : 0);
			};

			const onScroll = () => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			};

			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onScroll);
			update();
		});
	}

	initGoalsIntro();
	document.addEventListener("astro:page-load", initGoalsIntro);
</script>

<style>
	.goals-intro {
		background: var(--section-bg, var(--color-ink));
		color: var(--section-fg, var(--color-text-on-ink));
	}

	.goals-intro__head {
		flex-shrink: 0;
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 0 var(--gutter) 2rem;
		width: 100%;
	}

	.goals-intro__head h2 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
		line-height: var(--leading-tight);
		max-width: 40rem;
		margin: 0 0 1.5rem;
	}

	.goals-intro__head :global(.goals-intro__eyebrow) {
		display: block;
		margin-bottom: 1rem;
	}

	.goals-intro__head .goals-intro__description {
		max-width: 40rem;
		margin: -0.5rem 0 1.5rem;
		font-size: var(--text-body, 1rem);
		line-height: var(--leading-normal);
		color: var(--section-fg-muted, var(--color-text-on-ink-muted));
	}

	/* Milestone rail: fills with scroll, one dot per step. Desktop only. */
	.goals-intro__rail {
		display: none;
		align-items: center;
		gap: 1.5rem;
		max-width: var(--content-max);
		width: 100%;
		margin: 2.5rem auto 0;
		padding: 0 var(--gutter);
	}

	.is-scrubbing .goals-intro__rail {
		display: flex;
	}

	.goals-intro__rail-line {
		position: relative;
		flex: 1;
		height: 1px;
		background: var(--section-line, var(--color-line-on-ink));
	}

	.goals-intro__rail-fill {
		position: absolute;
		inset: 0;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
	}

	.goals-intro__rail-dot {
		position: absolute;
		top: 50%;
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: var(--section-bg, var(--color-ink));
		border: 1px solid var(--section-line, var(--color-line-on-ink));
		transform: translate(-50%, -50%);
		transition:
			background 0.3s ease,
			border-color 0.3s ease,
			transform 0.3s ease;
	}

	.goals-intro__rail-dot.is-reached {
		background: var(--color-accent);
		border-color: var(--color-accent);
	}

	/* Current step: an offset ring around the filled dot. */
	.goals-intro__rail-dot::after {
		content: "";
		position: absolute;
		inset: -0.4rem;
		border: 1px solid var(--color-accent);
		border-radius: 50%;
		opacity: 0;
		transform: scale(0.6);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}

	.goals-intro__rail-dot.is-current::after {
		opacity: 1;
		transform: scale(1);
	}

	.goals-intro__rail-count {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: var(--tracking-label);
		color: var(--section-fg-muted, var(--color-text-on-ink-muted));
	}

	.goals-intro__rail-count [data-step] {
		color: var(--color-accent);
	}

	/* Step highlight: upcoming steps dim, current lights up, passed stay lit. */
	.is-scrubbing .goals-intro__col {
		opacity: 0.4;
		transition:
			opacity 0.35s ease,
			border-color 0.35s ease;
	}

	.is-scrubbing .goals-intro__col.is-passed {
		opacity: 0.7;
	}

	.is-scrubbing .goals-intro__col.is-active {
		opacity: 1;
		border-bottom-color: var(--color-accent);
	}

	.is-scrubbing .goals-intro__col.is-active .goals-intro__icon,
	.is-scrubbing .goals-intro__col.is-passed .goals-intro__icon {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.goals-intro__col,
		.goals-intro__rail-dot,
		.goals-intro__rail-dot::after {
			transition: none;
		}
	}

	.goals-intro__track {
		position: relative;
	}

	.goals-intro__viewport {
		position: sticky;
		top: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		/* Spacing comes from the block's padding settings (set by SectionShell). */
		padding-top: var(--pad-top, 4rem);
		padding-bottom: var(--pad-bottom, 4rem);
	}

	.goals-intro__row {
		list-style: none;
		margin: 0;
		padding: 0 var(--gutter);
		display: flex;
		gap: 1.5rem;
		will-change: transform;
	}

	.goals-intro__col {
		flex-shrink: 0;
		width: min(22rem, 80vw);
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--section-line, var(--color-line-on-ink));
	}

	.goals-intro__icon {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-bottom: 1.5rem;
		border: 1px solid var(--section-line, var(--color-line-on-ink));
		border-radius: 0.6rem;
		color: var(--section-fg, var(--color-text-on-ink));
		transition:
			border-color 0.25s ease,
			color 0.25s ease;
	}

	.goals-intro__col:hover .goals-intro__icon {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.goals-intro__icon :global(img) {
		width: 62%;
		height: 62%;
		object-fit: contain;
	}

	.goals-intro__mark {
		display: block;
		position: relative;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--section-line, var(--color-line-on-ink));
		margin-bottom: 1.5rem;
	}

	.goals-intro__mark span {
		position: absolute;
		width: 45%;
		height: 45%;
		background: var(--section-fg-muted, var(--color-text-on-ink-muted));
	}

	.goals-intro__mark--top-left span {
		top: 0;
		left: 0;
	}

	.goals-intro__mark--top-right span {
		top: 0;
		right: 0;
	}

	.goals-intro__mark--bottom-right span {
		bottom: 0;
		right: 0;
	}

	.goals-intro__mark--bottom-left span {
		bottom: 0;
		left: 0;
	}

	.goals-intro__col h3 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.3rem;
		margin: 0 0 0.75rem;
	}

	.goals-intro__col p {
		font-size: var(--text-small);
		color: var(--section-fg-muted, var(--color-text-on-ink-muted));
		line-height: var(--leading-normal);
		margin: 0;
		/* Descriptions never run past two lines on the card. */
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
	}

	@media (max-width: 780px) {
		.goals-intro__track {
			height: auto !important;
		}

		.goals-intro__viewport {
			position: static;
			height: auto;
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scroll-snap-type: x mandatory;
		}

		.goals-intro__row {
			transform: none !important;
		}

		.goals-intro__col {
			scroll-snap-align: start;
		}
	}
</style>
