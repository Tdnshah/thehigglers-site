---
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";

interface LinkGroup {
	heading: string;
	links: { label: string; url: string }[];
}

interface Props {
	siteTitle: string;
	siteTagline?: string | null;
	contactEmail?: string;
	groups?: LinkGroup[];
}

const { siteTitle, siteTagline, contactEmail = "hello@thehigglers.com", groups = [] } =
	Astro.props;

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__cta">
		<h2>Let's build something worth remembering.</h2>
		<Button href="/contact" variant="primary">Start a conversation</Button>
	</div>

	<div class="site-footer__grid">
		<div class="site-footer__about">
			<span class="site-footer__brand">{siteTitle}</span>
			{siteTagline && <p>{siteTagline}</p>}
			<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
		</div>

		{
			groups.map((group) => (
				<div class="site-footer__group">
					<Eyebrow tone="muted">{group.heading}</Eyebrow>
					<ul>
						{group.links.map((link) => (
							<li>
								<a href={link.url}>{link.label}</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>

	<div class="site-footer__bottom">
		<span>© {year} {siteTitle}. All rights reserved.</span>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-ink);
		color: var(--color-text-on-ink);
		padding: var(--section-pad-y) var(--gutter) 2rem;
	}

	.site-footer__cta,
	.site-footer__grid,
	.site-footer__bottom {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.site-footer__cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-bottom: var(--section-pad-y);
		border-bottom: 1px solid var(--color-line-on-ink);
	}

	.site-footer__cta h2 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-h1);
		line-height: var(--leading-tight);
		max-width: 32rem;
		margin: 0;
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2.5rem;
		padding: 2.5rem 0;
	}

	.site-footer__brand {
		display: block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.15rem;
		margin-bottom: 0.75rem;
	}

	.site-footer__about p {
		color: var(--color-text-on-ink-muted);
		max-width: 22rem;
		margin: 0 0 0.75rem;
	}

	.site-footer__about a {
		color: var(--color-text-on-ink);
		text-decoration: none;
	}

	.site-footer__group ul {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.site-footer__group a {
		color: var(--color-text-on-ink-muted);
		text-decoration: none;
		font-size: var(--text-small);
		transition: color 0.15s ease;
	}

	.site-footer__group a:hover {
		color: var(--color-text-on-ink);
	}

	.site-footer__bottom {
		padding-top: 2rem;
		border-top: 1px solid var(--color-line-on-ink);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		color: var(--color-text-on-ink-muted);
	}

	@media (max-width: 720px) {
		.site-footer__grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
