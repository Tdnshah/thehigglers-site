---
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
import HeroBackdrop from "./HeroBackdrop.astro";
import HeroOrbitalVisual from "./HeroOrbitalVisual.astro";

interface Props {
	eyebrow: string;
	title: string;
	description: string;
	ctaLabel: string;
	ctaHref: string;
	meta?: string;
	/** Home-page mode: full-viewport hero that sits under the fixed overlay header. */
	overlay?: boolean;
}

const { eyebrow, title, description, ctaLabel, ctaHref, meta, overlay = false } = Astro.props;

// Break the headline at sentence ends so a CMS string like
// "Open technology. Serious engineering. Business outcomes." stacks as lines.
const sentences = title.split(/(?<=[.!?])\s+/).filter(Boolean);

// Wide screens: group the sentences into two lines with the most even length
// ("Open technology. Serious engineering." / "Business outcomes."). Narrow
// screens un-group them (one sentence per line) via CSS.
const groups: string[][] =
	sentences.length < 3
		? sentences.map((sentence) => [sentence])
		: (() => {
				let best = 1;
				let bestDiff = Infinity;
				for (let i = 1; i < sentences.length; i++) {
					const diff = Math.abs(
						sentences.slice(0, i).join(" ").length - sentences.slice(i).join(" ").length,
					);
					if (diff < bestDiff) {
						bestDiff = diff;
						best = i;
					}
				}
				return [sentences.slice(0, best), sentences.slice(best)];
			})();
---

<section class:list={["hero", overlay && "hero--overlay"]}>
	<HeroBackdrop />

	<div class="hero__inner">
		<HeroOrbitalVisual />

		<div class="hero__main">
			{eyebrow && (
				<div class="hero__eyebrow">
					<Eyebrow tone="accent">{eyebrow}</Eyebrow>
				</div>
			)}
			<h1>
				{groups.map((group, gi) => (
					<span class="hero__line">
						{group.map((sentence, si) => (
							<>
								<span
									class:list={[
										"hero__sentence",
										gi === groups.length - 1 && si === group.length - 1 && "hero__sentence--accent",
									]}
								>
									{sentence}
								</span>
								{si < group.length - 1 && " "}
							</>
						))}
					</span>
				))}
			</h1>
			{description && <p class="hero__description">{description}</p>}
			{ctaLabel && <Button href={ctaHref} variant="primary" class="hero__cta">{ctaLabel}</Button>}
		</div>

		{meta && <p class="hero__meta">{meta}</p>}
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background: var(--color-paper);
		padding: clamp(3rem, 2rem + 4vw, 6rem) var(--gutter) clamp(2.5rem, 2rem + 3vw, 5rem);
		border-bottom: 1px solid var(--color-line);
	}

	/* Desktop: exactly one viewport tall; type, spacing and the orbital scale
	   with the viewport height so nothing spills below the fold. */
	.hero--overlay {
		height: 100vh;
		height: 100svh;
		min-height: 34rem;
		display: flex;
		align-items: center;
		padding-top: calc(var(--site-header-h) + clamp(0.75rem, 3svh, 3rem));
		padding-bottom: clamp(1.25rem, 4svh, 4rem);
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--hero-max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		grid-template-rows: auto auto;
		column-gap: 2rem;
		row-gap: clamp(1rem, 3svh, 3rem);
	}

	.hero__main {
		position: relative;
		z-index: 2;
		grid-column: 1;
		grid-row: 1 / span 2;
		align-self: center;
		max-width: 56rem;
	}

	/* Eyebrow with a short leading rule */
	.hero__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.hero__eyebrow::before {
		content: "";
		width: 2rem;
		height: 1px;
		background: var(--color-brand);
		opacity: 0.55;
	}

	.hero__main h1 {
		margin: clamp(0.9rem, 2.6svh, 1.5rem) 0 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(2.1rem, min(0.6rem + 4.2vw, 8svh), 4.5rem);
		line-height: 1.06;
		letter-spacing: -0.04em;
		color: var(--color-text);
		text-wrap: balance;
	}

	.hero__line {
		display: block;
	}

	/* Below 1200px: one sentence per line (three short lines). */
	.hero__sentence {
		display: block;
	}

	/* Quiet emphasis on the closing sentence */
	.hero__sentence--accent {
		background: linear-gradient(100deg, #3f6ff0 0%, #6c5cf0 55%, #8b4fe8 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
	}

	.hero__description {
		max-width: 38rem;
		margin: clamp(1rem, 3svh, 1.75rem) 0 0;
		font-size: clamp(1rem, 0.94rem + 0.28vw, 1.25rem);
		line-height: 1.6;
		letter-spacing: -0.008em;
		color: #4a4e59;
		text-wrap: pretty;
	}

	.hero__main :global(.hero__cta) {
		margin-top: clamp(1.25rem, 3.4svh, 2.25rem);
		padding: clamp(0.8rem, 1.8svh, 1.05rem) 1.7rem;
		background: linear-gradient(100deg, #b8c8ff 0%, #a8bcff 55%, #9eb3ff 100%);
		box-shadow: 0 14px 35px rgba(86, 116, 220, 0.16);
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}

	.hero__main :global(.hero__cta:hover) {
		opacity: 1;
		transform: translateY(-2px);
		box-shadow: 0 18px 40px rgba(86, 116, 220, 0.26);
	}

	.hero__meta {
		position: relative;
		z-index: 2;
		grid-column: 2;
		grid-row: 2;
		justify-self: end;
		width: min(100%, 21rem);
		margin: 0;
		padding-top: 1rem;
		border-top: 1px solid var(--color-line);
		font-size: 0.9375rem;
		line-height: 1.6;
		letter-spacing: -0.005em;
		color: var(--color-text-muted);
		text-wrap: pretty;
	}

	/* Wide screens: two balanced lines, wider copy column, slightly
	   smaller orbital to make room. */
	@media (min-width: 1200px) {
		.hero__inner {
			grid-template-columns: minmax(0, 1.32fr) minmax(0, 0.68fr);
		}

		.hero__main h1 {
			font-size: clamp(2.5rem, min(3.3vw, 7.2svh), 4rem);
			line-height: 1.1;
			letter-spacing: -0.038em;
		}

		.hero__sentence {
			display: inline;
		}

		.hero__main {
			max-width: none;
		}
	}

	@media (max-width: 960px) {
		/* Stacked: at least one screen, grows only if content needs it. */
		.hero--overlay {
			height: auto;
			min-height: 100vh;
			min-height: 100svh;
			align-items: flex-start;
			padding-top: calc(var(--site-header-h) + clamp(0.75rem, 3svh, 2rem));
			padding-bottom: 1rem;
		}

		.hero__main h1 {
			font-size: clamp(1.9rem, min(8.2vw, 4.8svh), 3.75rem);
			line-height: 1.08;
		}

		.hero__description {
			max-width: 36rem;
			line-height: 1.55;
		}

		.hero__inner {
			display: flex;
			flex-direction: column;
			row-gap: clamp(0.75rem, 2svh, 1.5rem);
		}

		.hero__main {
			order: 1;
			grid-column: auto;
			grid-row: auto;
			align-self: stretch;
			max-width: 100%;
		}

		.hero__meta {
			order: 3;
			grid-column: auto;
			grid-row: auto;
			justify-self: auto;
			width: 100%;
			max-width: 28rem;
			padding-top: 0.75rem;
			font-size: var(--text-small);
		}

		.hero__main h1 {
			letter-spacing: -0.045em;
		}
	}
</style>
