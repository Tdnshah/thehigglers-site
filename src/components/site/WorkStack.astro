---
// Pinned scroll-stack: the viewport pins to the top of the screen while a
// tall "track" scrolls underneath it. Panels are absolutely stacked inside
// that pinned viewport; a tiny scroll-linked script (rAF, no library) drives
// each panel's translateY/scale/opacity as a function of scroll progress --
// so the outgoing panel visibly recedes (scales down, dims) while the next
// one slides up over it, instead of an instant cut.
import { Image } from "emdash/ui";
import type { ImageValue } from "emdash";
import Eyebrow from "./Eyebrow.astro";
import Button from "./Button.astro";

interface WorkItem {
	title: string;
	description: string;
	tags?: string[];
	href?: string;
	image?: ImageValue | string | null;
}

interface Props {
	items: WorkItem[];
}

const { items } = Astro.props;
---

<section class="work-stack" data-work-stack>
	<div class="work-stack__track" style={`height:${items.length * 100}vh`}>
		<div class="work-stack__viewport" data-work-viewport>
			{
				items.map((item, i) => (
					<div
						class:list={["work-stack__item", i % 2 === 1 && "work-stack__item--raised"]}
						data-work-item
						data-index={i}
						style={`z-index:${i + 1}`}
					>
						<div class="work-stack__inner">
							<Eyebrow tone="accent">{String(i + 1).padStart(2, "0")}</Eyebrow>

							<div class="work-stack__grid">
								<div class="work-stack__copy">
									<h3>{item.title}</h3>
									<p>{item.description}</p>

									{item.tags && item.tags.length > 0 && (
										<ul class="work-stack__tags">
											{item.tags.map((tag) => (
												<li>{tag}</li>
											))}
										</ul>
									)}

									{item.href && (
										<Button href={item.href} variant="on-ink">
											View case study
										</Button>
									)}
								</div>

								<div class="work-stack__media">
									{item.image ? (
										<Image image={item.image} />
									) : (
										<div class="work-stack__placeholder" aria-hidden="true" />
									)}
								</div>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	function initWorkStacks() {
		const stacks = document.querySelectorAll<HTMLElement>("[data-work-stack]");

		stacks.forEach((stack) => {
			const track = stack.querySelector<HTMLElement>(".work-stack__track");
			const items = Array.from(stack.querySelectorAll<HTMLElement>("[data-work-item]"));
			if (!track || items.length < 2) return;

			const isNarrow = () => window.matchMedia("(max-width: 780px)").matches;
			let ticking = false;

			const update = () => {
				ticking = false;
				if (isNarrow()) return;

				const rect = track.getBoundingClientRect();
				const vh = window.innerHeight;
				const scrolled = Math.min(Math.max(-rect.top, 0), rect.height - vh);

				items.forEach((el, i) => {
					// Panel i recedes as the transition into panel i+1 plays.
					if (i < items.length - 1) {
						const segStart = i * vh;
						const recede = Math.min(Math.max((scrolled - segStart) / vh, 0), 1);
						el.style.setProperty("--recede", String(recede));
					}
					// Panel i (except the first) enters during the previous segment.
					if (i > 0) {
						const segStart = (i - 1) * vh;
						const enter = Math.min(Math.max((scrolled - segStart) / vh, 0), 1);
						el.style.setProperty("--enter", String(enter));
					}
				});
			};

			const onScroll = () => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			};

			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onScroll);
			update();
		});
	}

	initWorkStacks();
	// In case view transitions get added later -- harmless no-op otherwise.
	document.addEventListener("astro:page-load", initWorkStacks);
</script>

<style>
	.work-stack__track {
		position: relative;
	}

	.work-stack__viewport {
		position: sticky;
		top: 0;
		height: 100vh;
		overflow: hidden;
	}

	.work-stack__item {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		background: var(--color-ink);
		color: var(--color-text-on-ink);
		--recede: 0;
		--enter: 1;
		transform: translateY(calc((1 - var(--enter)) * 100%)) scale(calc(1 - var(--recede) * 0.08));
		opacity: calc(1 - var(--recede) * 0.45);
		will-change: transform, opacity;
	}

	.work-stack__item--raised {
		background: var(--color-ink-raised);
	}

	.work-stack__inner {
		width: 100%;
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	.work-stack__grid {
		margin-top: 1.5rem;
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.work-stack__copy h3 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-h1);
		line-height: var(--leading-tight);
		margin: 0.5rem 0 1rem;
	}

	.work-stack__copy p {
		color: var(--color-text-on-ink-muted);
		font-size: var(--text-body);
		max-width: 30rem;
		margin: 0 0 1.5rem;
	}

	.work-stack__tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 2rem;
		padding: 0;
	}

	.work-stack__tags li {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
		color: var(--color-text-on-ink-muted);
		border: 1px solid var(--color-line-on-ink);
		border-radius: 999px;
		padding: 0.3rem 0.7rem;
	}

	.work-stack__media {
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-card);
		overflow: hidden;
		background: rgba(242, 241, 238, 0.06);
		border: 1px solid var(--color-line-on-ink);
	}

	.work-stack__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.work-stack__placeholder {
		width: 100%;
		height: 100%;
	}

	@media (max-width: 780px) {
		.work-stack__track {
			height: auto !important;
		}

		.work-stack__viewport {
			position: static;
			height: auto;
			overflow: visible;
			display: flex;
			flex-direction: column;
		}

		.work-stack__item {
			position: relative;
			inset: auto;
			min-height: 100vh;
			transform: none !important;
			opacity: 1 !important;
		}

		.work-stack__grid {
			grid-template-columns: 1fr;
		}

		.work-stack__media {
			order: -1;
		}
	}
</style>
