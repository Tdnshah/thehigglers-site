---
// Blog listing grid. Thin wrapper over the shared CardGrid using the
// "editorial" card (image, date, bold title, read time) so posts and the
// Card Grid block share one card component.
import type { ImageValue } from "emdash";
import CardGrid from "./CardGrid.astro";

interface PostItem {
	title: string;
	href: string;
	image?: ImageValue | null;
	date?: string | null;
	readTime?: string | null;
}

interface Props {
	items: PostItem[];
	emptyLabel?: string;
	/** Renders the first card wider than the rest (homepage teaser row only). */
	featureFirst?: boolean;
}

const { items, emptyLabel = "Nothing here yet.", featureFirst = false } = Astro.props;
const cards = items.map((p) => ({
	variant: "editorial" as const,
	title: p.title,
	href: p.href,
	image: p.image,
	meta: p.date,
	metaAfter: p.readTime,
}));
---

<CardGrid items={cards} columns={3} hover="none" featureFirst={featureFirst} emptyLabel={emptyLabel} />
