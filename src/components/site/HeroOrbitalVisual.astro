---
/**
 * Orbital hero visual (decorative, aria-hidden).
 *
 * The orbit is a set of OPEN-ENDED winding ribbons, not closed ellipses: each
 * ribbon is a spiral on a squashed ellipse that tapers to a point at both
 * ends. They are generated here from a parametric curve (offset edges along
 * the normal, width shaped by sin(pi * t)) so every ribbon is a single filled
 * path that can take the brand gradient. The whole system is tilted -34deg.
 *
 * Adapted from the supplied HeroOrbital-chatgptcode.astro (glow, labels,
 * gradient palette). Lives in `.hero__inner`'s grid (see Hero.astro).
 */
const CX = 300;
const CY = 250;
const ASPECT = 0.42;

interface Ribbon {
	turns: number;
	from: number;
	to: number;
	phase: number;
	width: number;
	opacity: number;
}

function ribbonPath({ turns, from, to, phase, width }: Ribbon, steps = 200) {
	const pts: Array<[number, number]> = [];
	for (let i = 0; i <= steps; i++) {
		const t = i / steps;
		const angle = phase + t * turns * Math.PI * 2;
		const scale = from + (to - from) * t;
		pts.push([CX + scale * Math.cos(angle), CY + scale * ASPECT * Math.sin(angle)]);
	}

	const left: string[] = [];
	const right: string[] = [];
	pts.forEach(([x, y], i) => {
		const [x0, y0] = pts[Math.max(i - 1, 0)];
		const [x1, y1] = pts[Math.min(i + 1, steps)];
		const len = Math.hypot(x1 - x0, y1 - y0) || 1;
		const nx = -(y1 - y0) / len;
		const ny = (x1 - x0) / len;
		const half = (width / 2) * Math.pow(Math.sin(Math.PI * (i / steps)), 0.9);
		left.push(`${(x + nx * half).toFixed(1)} ${(y + ny * half).toFixed(1)}`);
		right.push(`${(x - nx * half).toFixed(1)} ${(y - ny * half).toFixed(1)}`);
	});

	return `M${left.join("L")}L${right.reverse().join("L")}Z`;
}

const ribbons: Ribbon[] = [
	{ turns: 1.25, from: 60, to: 235, phase: 2.6, width: 46, opacity: 0.5 },
	{ turns: 1.4, from: 80, to: 255, phase: 2.1, width: 20, opacity: 0.42 },
	{ turns: 1.6, from: 105, to: 275, phase: 1.7, width: 3.2, opacity: 0.75 },
	{ turns: 1.3, from: 50, to: 210, phase: 3.2, width: 3.6, opacity: 0.6 },
	{ turns: 1.5, from: 130, to: 285, phase: 1.2, width: 1.6, opacity: 0.5 },
].map((r) => r);
const paths = ribbons.map((r) => ({ d: ribbonPath(r), opacity: r.opacity }));
---

<div class="hero-visual" aria-hidden="true">
	<div class="visual-glow"></div>

	<svg class="orbital-system" viewBox="0 0 600 500" fill="none" xmlns="http://www.w3.org/2000/svg">
		<defs>
			<linearGradient id="hov-grad" x1="40" y1="250" x2="560" y2="250" gradientUnits="userSpaceOnUse">
				<stop offset="0" stop-color="#5C8EFF"></stop>
				<stop offset=".5" stop-color="#6C7CFF"></stop>
				<stop offset="1" stop-color="#8B5CF6"></stop>
			</linearGradient>
			<radialGradient id="hov-core" cx="300" cy="250" r="130" gradientUnits="userSpaceOnUse">
				<stop offset="0" stop-color="#8FB8FF" stop-opacity=".9"></stop>
				<stop offset=".5" stop-color="#6C7CFF" stop-opacity=".45"></stop>
				<stop offset="1" stop-color="#9B7CFF" stop-opacity="0"></stop>
			</radialGradient>
			<filter id="hov-blur" x="-100%" y="-100%" width="300%" height="300%">
				<feGaussianBlur stdDeviation="22"></feGaussianBlur>
			</filter>
			<filter id="hov-soft" x="-50%" y="-50%" width="200%" height="200%">
				<feGaussianBlur stdDeviation="6"></feGaussianBlur>
			</filter>
		</defs>

		<g class="orbital-float">
			<g transform="rotate(-34 300 250)">
				<ellipse cx="300" cy="250" rx="150" ry="62" fill="url(#hov-core)" filter="url(#hov-blur)"></ellipse>

				<g class="orbital-spin">
					{paths.map((p) => <path d={p.d} fill="url(#hov-grad)" opacity={p.opacity} />)}
					<ellipse
						cx="300"
						cy="250"
						rx="84"
						ry="26"
						fill="url(#hov-grad)"
						opacity=".55"
						filter="url(#hov-soft)"></ellipse>
				</g>
			</g>
		</g>

		<circle class="particle particle--one" cx="505" cy="138" r="5" fill="#713DEB"></circle>
		<circle class="particle particle--two" cx="108" cy="352" r="4" fill="#3D7CFF"></circle>
		<circle class="particle particle--three" cx="468" cy="368" r="3" fill="#8B5CF6"></circle>
	</svg>

	<div class="floating-label label-api">
		<span class="label-icon">&lt;/&gt;</span>
		<span>APIs &amp; Integrations</span>
	</div>

	<div class="floating-label label-cloud">
		<span class="label-icon">
			<svg viewBox="0 0 24 24">
				<path d="M6.5 18.5h11a4 4 0 0 0 .5-8 6 6 0 0 0-11.5 1A3.5 3.5 0 0 0 6.5 18.5Z"></path>
			</svg>
		</span>
		<span>Cloud</span>
	</div>

	<div class="floating-label label-cms">
		<span class="label-icon">
			<svg viewBox="0 0 24 24">
				<ellipse cx="12" cy="5" rx="6" ry="3"></ellipse>
				<path d="M6 5v7c0 1.7 2.7 3 6 3s6-1.3 6-3V5"></path>
				<path d="M6 12v7c0 1.7 2.7 3 6 3s6-1.3 6-3v-7"></path>
			</svg>
		</span>
		<span>CMS</span>
	</div>

	<div class="floating-label label-infra">
		<span class="label-icon">
			<svg viewBox="0 0 24 24">
				<rect x="4" y="4" width="6" height="6" rx="1"></rect>
				<rect x="14" y="4" width="6" height="6" rx="1"></rect>
				<rect x="4" y="14" width="6" height="6" rx="1"></rect>
				<rect x="14" y="14" width="6" height="6" rx="1"></rect>
			</svg>
		</span>
		<span>Infrastructure</span>
	</div>
</div>

<style>
	/* Desktop: a grid cell in the hero's right column (row 1), with the meta
	   text in row 2 beneath it, so the two can never overlap. */
	.hero-visual {
		position: relative;
		z-index: 0;
		grid-column: 2;
		grid-row: 1;
		align-self: center;
		justify-self: end;
		/* Height budget: viewport minus header and the meta row below. */
		width: min(112%, 46rem, max(18rem, calc((100svh - var(--site-header-h) - 14rem) * 1.2)));
		margin-left: -12%;
		aspect-ratio: 6 / 5;
		margin-bottom: 1.5rem;
		pointer-events: none;
		animation: hv-in-flow 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.visual-glow {
		position: absolute;
		left: 16%;
		top: 20%;
		width: 70%;
		height: 62%;
		border-radius: 50%;
		background: radial-gradient(
			ellipse,
			rgba(75, 148, 255, 0.4) 0%,
			rgba(105, 101, 255, 0.22) 35%,
			rgba(132, 91, 246, 0.07) 58%,
			transparent 74%
		);
		filter: blur(40px);
		animation: hv-glow 8s ease-in-out infinite;
	}

	.orbital-system {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.orbital-float {
		transform-origin: 300px 250px;
		animation: hv-float 10s ease-in-out infinite;
	}

	.orbital-spin {
		transform-origin: 300px 250px;
		animation: hv-sway 28s ease-in-out infinite alternate;
	}

	.particle {
		transform-box: fill-box;
		transform-origin: center;
	}

	.particle--one {
		animation: hv-p1 8s ease-in-out infinite;
	}

	.particle--two {
		animation: hv-p2 10s ease-in-out infinite;
	}

	.particle--three {
		animation: hv-p3 7s ease-in-out infinite;
	}

	.floating-label {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-height: 2.75rem;
		padding: 0 1.05rem;
		border: 1px solid rgba(225, 229, 240, 0.8);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.74);
		box-shadow:
			0 12px 35px rgba(40, 65, 120, 0.07),
			inset 0 1px rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(14px);
		color: #365a8b;
		font-size: clamp(0.72rem, 0.66rem + 0.2vw, 0.8125rem);
		font-weight: 500;
		white-space: nowrap;
		animation: hv-label 7s ease-in-out infinite;
	}

	.label-icon {
		display: grid;
		place-items: center;
		color: #3974c9;
		font-weight: 700;
		font-size: 1rem;
	}

	.label-icon svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.label-api {
		top: 6%;
		left: 20%;
		animation-delay: -0.8s;
	}

	.label-cloud {
		top: 36%;
		left: 0;
		animation-delay: -2.5s;
	}

	.label-cms {
		top: 43%;
		right: -1%;
		animation-delay: -4s;
	}

	.label-infra {
		bottom: 22%;
		right: 6%;
		animation-delay: -1.5s;
	}

	@keyframes hv-glow {
		0%,
		100% {
			transform: scale(0.94);
			opacity: 0.65;
		}
		50% {
			transform: scale(1.06);
			opacity: 1;
		}
	}

	@keyframes hv-float {
		0%,
		100% {
			transform: translate3d(0, 0, 0);
		}
		50% {
			transform: translate3d(0, -8px, 0);
		}
	}

	@keyframes hv-sway {
		from {
			transform: rotate(-4deg) scale(0.99);
		}
		to {
			transform: rotate(5deg) scale(1.02);
		}
	}

	@keyframes hv-p1 {
		0%,
		100% {
			transform: translate(0, 0);
			opacity: 0.8;
		}
		50% {
			transform: translate(-9px, 13px);
			opacity: 1;
		}
	}

	@keyframes hv-p2 {
		0%,
		100% {
			transform: translate(0, 0);
		}
		50% {
			transform: translate(10px, -12px);
		}
	}

	@keyframes hv-p3 {
		0%,
		100% {
			transform: translate(0, 0);
			opacity: 0.6;
		}
		50% {
			transform: translate(-7px, -8px);
			opacity: 1;
		}
	}

	@keyframes hv-label {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-5px);
		}
	}

	/* Single column: the visual drops in below the copy, in flow. */
	@media (max-width: 960px) {
		.hero-visual {
			order: 2;
			grid-column: auto;
			grid-row: auto;
			justify-self: auto;
			width: min(100%, 32rem, 31svh);
			min-width: 13.5rem;
			margin: 0.5rem auto 0;
		}

		.floating-label {
			min-height: 2.25rem;
			padding: 0 0.7rem;
			border-radius: 10px;
			gap: 0.4rem;
			font-size: 0.65rem;
		}

		.label-icon svg {
			width: 1rem;
			height: 1rem;
		}

		.label-api {
			left: 12%;
		}

		.label-cms {
			right: 0;
		}
	}

	@keyframes hv-in-flow {
		from {
			opacity: 0;
			transform: scale(0.95);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-visual,
		.visual-glow,
		.orbital-float,
		.orbital-spin,
		.particle,
		.floating-label {
			animation: none !important;
		}
	}
</style>
