---
import Button from "./Button.astro";

interface MenuItem {
	url: string;
	target?: string;
	label: string;
}

interface Props {
	siteTitle: string;
	siteLogo: { url: string; alt?: string | null } | null;
	menuItems: MenuItem[];
	/**
	 * Home-page mode: fixed, full-width and transparent over the hero, then
	 * morphs into a floating container (aligned to the content column below)
	 * once the page scrolls.
	 */
	overlay?: boolean;
}

const { siteTitle, siteLogo, menuItems, overlay = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (url: string) => {
	if (/^https?:/.test(url)) return false;
	const target = url.replace(/\/$/, "") || "/";
	return target === "/" ? path === "/" : path === target || path.startsWith(`${target}/`);
};
---

<header class:list={["site-header", overlay && "site-header--overlay"]} data-overlay={overlay} data-scrolled="false" data-open="false">
	<div class="site-header__bar">
		<a href="/" class="site-header__brand">
			{
				siteLogo ? (
					<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
				) : (
					<span>{siteTitle}</span>
				)
			}
		</a>

		<nav class="site-header__nav" aria-label="Primary">
			{
				menuItems.map((item) => (
					<a href={item.url} target={item.target} aria-current={isActive(item.url) ? "page" : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="site-header__actions">
			<slot name="search" />
			<Button href="/contact" variant="ghost" class="site-header__cta">Get in touch</Button>
		</div>

		<button
			class="site-header__toggle"
			type="button"
			aria-label="Toggle menu"
			aria-expanded="false"
			aria-controls="site-header-panel"
		>
			<span></span>
			<span></span>
		</button>

		<div class="site-header__panel" id="site-header-panel">
			{
				menuItems.map((item) => (
					<a href={item.url} target={item.target} aria-current={isActive(item.url) ? "page" : undefined}>
						{item.label}
					</a>
				))
			}
			<Button href="/contact" variant="primary">Get in touch</Button>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>(".site-header");
	const toggle = header?.querySelector<HTMLButtonElement>(".site-header__toggle");

	if (header) {
		if (header.dataset.overlay === "true") {
			let ticking = false;
			const update = () => {
				header.dataset.scrolled = String(window.scrollY > 24);
				ticking = false;
			};
			update();
			window.addEventListener(
				"scroll",
				() => {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(update);
					}
				},
				{ passive: true },
			);
		}

		const setOpen = (open: boolean) => {
			header.dataset.open = String(open);
			toggle?.setAttribute("aria-expanded", String(open));
		};

		toggle?.addEventListener("click", () => setOpen(header.dataset.open !== "true"));
		header.querySelectorAll(".site-header__panel a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
		document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
		window.matchMedia("(min-width: 901px)").addEventListener("change", (e) => e.matches && setOpen(false));
	}
</script>

<style>
	/* ---------- Base (all pages): sticky, paper background ---------- */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: var(--color-paper);
		padding: 0 var(--gutter);
	}

	.site-header__bar {
		position: relative;
		max-width: var(--content-max);
		margin: 0 auto;
		min-height: 4.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.site-header__brand {
		display: flex;
		align-items: center;
		text-decoration: none;
		flex-shrink: 0;
	}

	.site-header__brand img {
		height: 2.5rem;
		width: auto;
		display: block;
	}

	.site-header__brand span {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.25rem;
		color: var(--color-text);
	}

	.site-header__nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.site-header__nav a {
		position: relative;
		padding: 0.6rem 0.95rem;
		border-radius: var(--radius-pill);
		color: var(--color-text-muted);
		text-decoration: none;
		transition:
			color 0.2s ease,
			background-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	.site-header__nav a:hover,
	.site-header__nav a[aria-current="page"] {
		color: var(--color-text);
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.site-header__toggle,
	.site-header__panel {
		display: none;
	}

	/* ---------- Overlay (home): full width, then container on scroll ---------- */
	.site-header--overlay {
		position: fixed;
		inset: 0 0 auto 0;
		background: transparent;
		pointer-events: none;
		transition: padding 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.site-header--overlay .site-header__bar {
		--ease: cubic-bezier(0.16, 1, 0.3, 1);
		pointer-events: auto;
		width: 100%;
		max-width: var(--hero-max);
		min-height: var(--site-header-h);
		padding: 0;
		border: 1px solid transparent;
		border-bottom-color: rgba(20, 30, 50, 0.07);
		border-radius: 0;
		background: rgba(255, 255, 255, 0);
		backdrop-filter: blur(0) saturate(1);
		-webkit-backdrop-filter: blur(0) saturate(1);
		box-shadow: 0 0 0 rgba(20, 30, 60, 0);
		transition:
			max-width 0.7s var(--ease),
			min-height 0.7s var(--ease),
			margin-top 0.7s var(--ease),
			padding 0.7s var(--ease),
			border-radius 0.7s var(--ease),
			background-color 0.5s ease,
			border-color 0.5s ease,
			box-shadow 0.7s ease,
			backdrop-filter 0.5s ease;
	}

	.site-header--overlay[data-scrolled="true"] .site-header__bar {
		max-width: var(--content-max);
		min-height: 3.75rem;
		margin-top: 0.75rem;
		padding: 0.4rem 0.5rem 0.4rem 1.25rem;
		border-color: var(--color-line);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.94);
		backdrop-filter: blur(16px) saturate(1.4);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		box-shadow: 0 12px 40px rgba(20, 30, 60, 0.09);
	}

	/* The menu items gather into their own capsule as the bar condenses. */
	.site-header--overlay .site-header__nav {
		padding: 0.25rem;
		border: 1px solid transparent;
		border-radius: var(--radius-pill);
		background: rgba(245, 244, 242, 0);
		transition:
			background-color 0.5s ease,
			border-color 0.5s ease,
			margin 0.7s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.site-header--overlay[data-scrolled="true"] .site-header__nav {
		background: rgba(245, 244, 242, 0.9);
		border-color: var(--color-line);
	}

	.site-header--overlay[data-scrolled="true"] .site-header__nav a[aria-current="page"] {
		background: var(--color-paper);
		box-shadow: 0 2px 10px rgba(20, 30, 60, 0.08);
	}

	/* Underline marker for the active item while the bar is still full width. */
	.site-header--overlay[data-scrolled="false"] .site-header__nav a[aria-current="page"]::after {
		content: "";
		position: absolute;
		left: 0.95rem;
		right: 0.95rem;
		bottom: 0.25rem;
		height: 2px;
		border-radius: 2px;
		background: #477bff;
	}

	/* ---------- Mobile ---------- */
	@media (max-width: 900px) {
		.site-header__nav,
		.site-header__actions :global(.site-header__cta) {
			display: none;
		}

		.site-header__toggle {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 5px;
			width: 2.75rem;
			height: 2.75rem;
			padding: 0;
			border: 1px solid var(--color-line);
			border-radius: 50%;
			background: rgba(255, 255, 255, 0.85);
			cursor: pointer;
		}

		.site-header__toggle span {
			width: 15px;
			height: 1.5px;
			background: var(--color-text);
			transition: transform 0.25s ease;
		}

		.site-header[data-open="true"] .site-header__toggle span:first-child {
			transform: translateY(3.25px) rotate(45deg);
		}

		.site-header[data-open="true"] .site-header__toggle span:last-child {
			transform: translateY(-3.25px) rotate(-45deg);
		}

		.site-header__panel {
			position: absolute;
			top: calc(100% + 0.5rem);
			left: 0;
			right: 0;
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding: 0.75rem;
			border: 1px solid var(--color-line);
			border-radius: 1.25rem;
			background: rgba(255, 255, 255, 0.96);
			backdrop-filter: blur(20px);
			-webkit-backdrop-filter: blur(20px);
			box-shadow: 0 20px 50px rgba(30, 50, 90, 0.12);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transform: translateY(-8px);
			transition:
				opacity 0.25s ease,
				transform 0.25s ease,
				visibility 0.25s;
		}

		.site-header[data-open="true"] .site-header__panel {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: none;
		}

		.site-header__panel a:not(.btn) {
			padding: 0.9rem 1rem;
			border-radius: 0.75rem;
			font-family: var(--font-mono);
			font-size: var(--text-label);
			letter-spacing: var(--tracking-label);
			text-transform: uppercase;
			text-decoration: none;
			color: var(--color-text-muted);
		}

		.site-header__panel a[aria-current="page"] {
			background: var(--color-paper-soft);
			color: var(--color-text);
		}

		.site-header__panel :global(.btn) {
			justify-content: center;
			margin-top: 0.25rem;
		}

		.site-header--overlay[data-scrolled="true"] .site-header__bar {
			padding-left: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header--overlay,
		.site-header--overlay .site-header__bar,
		.site-header--overlay .site-header__nav,
		.site-header__panel {
			transition: none;
		}
	}
</style>
