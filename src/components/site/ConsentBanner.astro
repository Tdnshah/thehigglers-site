---
// Cookie consent + Google Analytics 4. Analytics loads ONLY after the visitor
// accepts; "Decline" loads nothing. The choice is remembered for 12 months and
// can be changed from the footer ("Cookie settings"). Analytics is skipped on
// the dev server so local visits never pollute the real data.
interface Props {
	gaId: string;
}

const { gaId } = Astro.props;
const isDev = import.meta.env.DEV;
---

<div class="consent" role="region" aria-label="Cookie consent" data-consent data-ga={gaId} data-dev={isDev ? "" : undefined} hidden>
	<div class="consent__text">
		<p class="consent__title">Cookies</p>
		<p>We use analytics cookies to understand how the site is used and to improve it. They stay off unless you accept.</p>
	</div>
	<div class="consent__actions">
		<button type="button" class="consent__btn consent__btn--primary" data-consent-accept>Accept</button>
		<button type="button" class="consent__btn consent__btn--ghost" data-consent-decline>Decline</button>
	</div>
</div>

<script>
	const KEY = "thg-consent";
	const MAX_AGE_MS = 365 * 24 * 60 * 60 * 1000;

	type Choice = "granted" | "denied";
	const read = (): Choice | null => {
		try {
			const raw = JSON.parse(localStorage.getItem(KEY) ?? "null");
			if (raw && (raw.v === "granted" || raw.v === "denied") && Date.now() - raw.t < MAX_AGE_MS) return raw.v;
		} catch {}
		return null;
	};
	const write = (v: Choice) => {
		try {
			localStorage.setItem(KEY, JSON.stringify({ v, t: Date.now() }));
		} catch {}
	};

	const root = document.querySelector<HTMLElement>("[data-consent]");
	if (root) {
		const gaId = root.dataset.ga ?? "";
		const isDev = root.dataset.dev !== undefined;
		const w = window as unknown as Record<string, unknown> & { dataLayer?: unknown[]; gtag?: (...a: unknown[]) => void };

		const loadAnalytics = () => {
			if (isDev || !gaId || w.__gaLoaded) return;
			w.__gaLoaded = true;
			w[`ga-disable-${gaId}`] = false;
			w.dataLayer = w.dataLayer ?? [];
			w.gtag = function () {
				// eslint-disable-next-line prefer-rest-params
				w.dataLayer!.push(arguments);
			};
			w.gtag("consent", "default", {
				analytics_storage: "granted",
				ad_storage: "denied",
				ad_user_data: "denied",
				ad_personalization: "denied",
			});
			w.gtag("js", new Date());
			w.gtag("config", gaId);
			const s = document.createElement("script");
			s.async = true;
			s.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
			document.head.appendChild(s);
		};

		const stopAnalytics = () => {
			if (gaId) w[`ga-disable-${gaId}`] = true;
			// Remove Google Analytics cookies set earlier (own domain and parent domain).
			const host = location.hostname.split(".");
			const domains = [location.hostname, host.length > 2 ? `.${host.slice(-2).join(".")}` : `.${location.hostname}`];
			document.cookie.split(";").forEach((c) => {
				const name = c.split("=")[0].trim();
				if (name === "_ga" || name.startsWith("_ga_") || name === "_gid") {
					domains.forEach((d) => {
						document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=${d}`;
					});
					document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/`;
				}
			});
		};

		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const show = () => {
			root.hidden = false;
			requestAnimationFrame(() => root.classList.add("is-open"));
		};
		const hide = () => {
			root.classList.remove("is-open");
			window.setTimeout(() => (root.hidden = true), reduced ? 0 : 250);
		};

		const choice = read();
		if (choice === "granted") loadAnalytics();
		else if (choice === null) show();

		root.querySelector("[data-consent-accept]")?.addEventListener("click", () => {
			write("granted");
			loadAnalytics();
			hide();
		});
		root.querySelector("[data-consent-decline]")?.addEventListener("click", () => {
			write("denied");
			stopAnalytics();
			hide();
		});

		// Footer "Cookie settings" reopens the banner.
		document.addEventListener("click", (e) => {
			if ((e.target as HTMLElement).closest("[data-cookie-settings]")) {
				show();
				root.querySelector<HTMLElement>("[data-consent-accept]")?.focus();
			}
		});
	}
</script>

<style>
	.consent {
		position: fixed;
		left: var(--gutter);
		bottom: 1.25rem;
		z-index: 60;
		display: grid;
		gap: 1rem;
		max-width: 26rem;
		padding: 1.25rem 1.5rem;
		background: var(--color-ink);
		color: var(--color-text-on-ink);
		border: 1px solid var(--color-line-on-ink);
		border-radius: 0.75rem;
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	.consent[hidden] {
		display: none;
	}

	.consent.is-open {
		opacity: 1;
		transform: none;
	}

	.consent__title {
		margin: 0 0 0.35rem;
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.consent__text p {
		margin: 0;
		font-size: var(--text-small);
		line-height: var(--leading-normal);
		color: var(--color-text-on-ink-muted);
	}

	.consent__text .consent__title {
		color: var(--color-accent);
	}

	.consent__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.consent__btn {
		padding: 0.6rem 1.1rem;
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		cursor: pointer;
		border: 1px solid transparent;
		transition: opacity 0.15s ease;
	}

	.consent__btn:hover {
		opacity: 0.85;
	}

	.consent__btn:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.consent__btn--primary {
		background: var(--color-accent);
		color: var(--color-accent-ink);
	}

	.consent__btn--ghost {
		background: transparent;
		color: var(--color-text-on-ink);
		border-color: var(--color-line-on-ink);
	}

	@media (max-width: 520px) {
		.consent {
			left: 0.75rem;
			right: 0.75rem;
			max-width: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.consent {
			transition: none;
			transform: none;
		}
	}
</style>
