---
// Trust strip / "logo wall". Text wordmarks, not fabricated client logos --
// swap in real client logos via `logos` (image + alt) once you have
// permission to display them; falls back to plain text otherwise.
import { Image } from "emdash/ui";
import type { ImageValue } from "emdash";
import Eyebrow from "./Eyebrow.astro";

interface Logo {
	label: string;
	image?: ImageValue | null;
	href?: string | null;
}

interface Props {
	label?: string | null;
	logos: Logo[];
}

const { label: labelProp, logos } = Astro.props;
const label = labelProp || "Engineering across open-source ecosystems";
// Duplicated once so the CSS marquee loop is seamless.
const track = [...logos, ...logos];
---

<section class="logo-wall">
	<div class="logo-wall__inner">
		<Eyebrow tone="muted">{label}</Eyebrow>

		<div class="logo-wall__viewport">
			<ul class="logo-wall__track">
				{track.map((logo, i) => (
					<li class:list={[i >= logos.length && "logo-wall__duplicate"]} aria-hidden={i >= logos.length}>
						{logo.href ? (
							<a href={logo.href} tabindex={i >= logos.length ? -1 : undefined} target="_blank" rel="noopener noreferrer">
								{logo.image ? <Image image={{ ...logo.image, alt: logo.label }} height={36} /> : logo.label}
							</a>
						) : logo.image ? (
							<Image image={{ ...logo.image, alt: logo.label }} height={36} />
						) : (
							logo.label
						)}
					</li>
				))}
			</ul>
		</div>
	</div>
</section>

<style>
	.logo-wall {
		padding: var(--pad-top, 3rem) var(--gutter) var(--pad-bottom, 3rem);
		border-bottom: 1px solid var(--color-line);
	}

	.logo-wall__inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.logo-wall__inner > :global(.eyebrow) {
		display: block;
		margin-bottom: 1.75rem;
	}

	.logo-wall__viewport {
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
	}

	.logo-wall__track {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		gap: 3.5rem;
		width: max-content;
		animation: logo-wall-scroll 28s linear infinite;
	}

	.logo-wall__track li {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.35rem;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.logo-wall__track li :global(img) {
		display: block;
		height: 2.25rem;
		width: auto;
		max-width: 9rem;
		object-fit: contain;
		filter: grayscale(1);
		opacity: 0.65;
		transition:
			filter 0.2s ease,
			opacity 0.2s ease;
	}

	.logo-wall__track li :global(img:hover),
	.logo-wall__track li a:hover :global(img) {
		filter: none;
		opacity: 1;
	}

	.logo-wall__track li a {
		color: inherit;
		text-decoration: none;
	}

	@keyframes logo-wall-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-wall__track {
			animation: none;
			flex-wrap: wrap;
			width: 100%;
		}

		.logo-wall__duplicate {
			display: none;
		}
	}
</style>
