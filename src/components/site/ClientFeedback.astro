---
// Grid of client testimonials. Sourced by whatever caller queries the
// "testimonials" collection (see blocks/TestimonialsSection.astro) and hands
// this component the resulting entries -- this component only renders them.
import { sanitizeHref } from "emdash";
import { Image } from "emdash/ui";
import type { ContentEntry } from "emdash";
import type { Testimonial } from "../../../emdash-env";

interface Props {
	items: ContentEntry<Testimonial>[];
	heading?: string | null;
	viewMoreLabel?: string | null;
	viewMoreUrl?: string | null;
}

const { items, heading, viewMoreLabel, viewMoreUrl } = Astro.props;
---

{
	items.length > 0 && (
		<section class="client-feedback">
			<div class="client-feedback__inner">
				{heading && <h2 class="client-feedback__heading">{heading}</h2>}
				<ul class="client-feedback__grid">
					{items.map((item) => (
						<li class="client-feedback__card">
							<p class="client-feedback__quote">&ldquo;{item.data.testimonial}&rdquo;</p>
							<div class="client-feedback__byline">
								<span class="client-feedback__avatar">
									<Image
										image={item.data.person_avtar}
										alt={item.data.full_name}
										class="client-feedback__avatar-img"
									/>
								</span>
								<div class="client-feedback__meta">
									<span class="client-feedback__name">{item.data.full_name}</span>
									<span class="client-feedback__role">
										{item.data.person_title}, {item.data.client_company}
									</span>
								</div>
							</div>
							<a
								class="client-feedback__company-link"
								href={sanitizeHref(item.data.company_website)}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span class="client-feedback__company-logo">
									<Image
										image={item.data.company_logo}
										alt={item.data.client_company}
										class="client-feedback__company-logo-img"
									/>
								</span>
							</a>
						</li>
					))}
				</ul>
				{viewMoreUrl && viewMoreLabel && (
					<a class="client-feedback__view-more" href={sanitizeHref(viewMoreUrl)}>
						{viewMoreLabel}
					</a>
				)}
			</div>
		</section>
	)
}

<style>
	.client-feedback {
		padding: var(--pad-top, var(--section-pad-y)) var(--gutter) var(--pad-bottom, var(--section-pad-y));
		border-bottom: 1px solid var(--color-line);
	}

	.client-feedback__inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.client-feedback__heading {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-h2);
		line-height: var(--leading-tight);
		margin: 0 0 1.5rem;
		text-align: center;
	}

	.client-feedback__view-more {
		display: block;
		text-align: center;
		margin-top: 2rem;
		font-family: var(--font-mono);
		font-size: var(--text-label);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.client-feedback__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		/* Hairlines come from card borders (not a grey grid background) so an
		   incomplete last row never shows an empty grey cell. */
		border-top: 1px solid var(--color-line);
		border-left: 1px solid var(--color-line);
	}

	.client-feedback__card {
		background: var(--color-paper);
		border-right: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 16rem;
	}

	.client-feedback__quote {
		font-family: var(--font-display);
		font-size: 1.15rem;
		line-height: var(--leading-snug);
		color: var(--color-text);
		margin: 0 0 1.5rem;
	}

	.client-feedback__byline {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.client-feedback__avatar {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 999px;
		overflow: hidden;
		flex-shrink: 0;
	}

	.client-feedback__avatar :global(.client-feedback__avatar-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Fallback when the image has no focal point set in the Media Library --
		   <Image> applies object-position from focalX/focalY as an inline style
		   when present, which (being inline) always wins over this rule. */
		object-position: center;
		display: block;
	}

	.client-feedback__meta {
		display: flex;
		flex-direction: column;
	}

	.client-feedback__name {
		font-size: var(--text-small);
		font-weight: 600;
		color: var(--color-text);
	}

	.client-feedback__role {
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	.client-feedback__company-link {
		display: inline-block;
		margin-top: 1.25rem;
	}

	.client-feedback__company-logo {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		width: 6rem;
		height: 1.75rem;
	}

	.client-feedback__company-logo :global(.client-feedback__company-logo-img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: left center;
		display: block;
	}

	@media (max-width: 780px) {
		.client-feedback__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
