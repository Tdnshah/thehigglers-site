---
// One reusable card with eight layouts ("variants"). Everything but the title is
// optional and the layout closes up cleanly when a part is missing. A card with
// an href is clickable as a whole (a single stretched link, so there is only one
// tab stop); the CTA label is the visible affordance.
//
//   image-top   photo above, text below (services, case studies)
//   image-left  photo beside the text (wide lists)
//   icon        small icon tile above the title
//   text        bordered text-only card
//   highlight   filled (dark) feature card
//   numbered    big index number, for steps / process
//   link-row    compact row with an arrow, for dense lists
//   editorial   the blog listing card: image, meta, title, read time
import { Image } from "emdash/ui";
import type { ImageValue } from "emdash";
import { STEP_ICONS, isStepIcon } from "../../utils/step-icons";

export type CardVariant = "image-top" | "image-left" | "icon" | "text" | "highlight" | "numbered" | "link-row" | "editorial";

interface Props {
	variant?: CardVariant;
	title: string;
	description?: string | null;
	href?: string | null;
	ctaLabel?: string | null;
	newTab?: boolean | null;
	image?: ImageValue | null;
	icon?: string | null;
	iconImage?: ImageValue | null;
	eyebrow?: string | null;
	tags?: string[];
	/** Small mono line. Editorial: shown above the title (e.g. a date). */
	meta?: string | null;
	/** Editorial only: shown under the title (e.g. "5 min read"). */
	metaAfter?: string | null;
	/** Numbered variant: "01", "02", ... */
	number?: string | null;
	/** Colour override: default | white | soft | dark | accent. */
	tone?: string | null;
	/** Editorial: fixed-height media for a featured first card. */
	featured?: boolean;
	/** contain = whole image visible (default); cover = fills the frame, may crop. */
	fit?: "contain" | "cover";
	headingLevel?: "h2" | "h3" | "h4";
}

const {
	variant = "image-top",
	title,
	description,
	href,
	ctaLabel,
	newTab,
	image,
	icon,
	iconImage,
	eyebrow,
	tags = [],
	meta,
	metaAfter,
	number,
	tone,
	featured = false,
	fit = "contain",
	headingLevel = "h3",
}: Props = Astro.props;

const Heading = headingLevel;
const hasImage = Boolean(image && (image.src || image.id));
const hasMedia = variant === "image-top" || variant === "image-left" || variant === "editorial";
const hasIconImage = Boolean(iconImage && (iconImage.src || iconImage.id));
const showIcon = variant === "icon" && (hasIconImage || isStepIcon(icon));
const cardTone = ["white", "soft", "dark", "accent"].includes(tone ?? "") ? tone : variant === "highlight" ? "dark" : "default";
const target = newTab ? "_blank" : undefined;
const rel = newTab ? "noopener noreferrer" : undefined;
---

<article class:list={["card", `card--${variant}`, featured && "card--featured", fit === "cover" || variant === "editorial" ? "card--fit-cover" : "card--fit-contain"]} data-tone={cardTone} data-linked={href ? "" : undefined}>
	{
		hasMedia && (hasImage || variant === "editorial") && (
			<div class="card__media">
				{hasImage && image ? <Image image={image} /> : <div class="card__placeholder" aria-hidden="true" />}
			</div>
		)
	}

	<div class="card__body">
		{variant === "numbered" && number && <span class="card__number" aria-hidden="true">{number}</span>}

		{
			showIcon && (
				<span class="card__icon" aria-hidden="true">
					{hasIconImage && iconImage ? (
						<Image image={{ ...iconImage, alt: "" }} width={44} height={44} />
					) : (
						isStepIcon(icon) && (
							<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={STEP_ICONS[icon]} />
						)
					)}
				</span>
			)
		}

		{eyebrow && <span class="card__eyebrow">{eyebrow}</span>}

		{
			tags.length > 0 && (
				<ul class="card__tags" aria-label="Tags">
					{tags.map((tag) => (
						<li class="card__tag">{tag}</li>
					))}
				</ul>
			)
		}

		{variant === "editorial" && meta && (
			<>
				<span class="card__meta card__meta--top">{meta}</span>
				<span class="card__divider" aria-hidden="true" />
			</>
		)}

		<Heading class="card__title">
			{href ? <a class="card__link" href={href} target={target} rel={rel}>{title}</a> : title}
		</Heading>

		{description && <p class="card__text">{description}</p>}

		{variant === "editorial" && metaAfter && <span class="card__meta card__meta--after">{metaAfter}</span>}
		{variant !== "editorial" && meta && <span class="card__meta">{meta}</span>}

		{
			(ctaLabel || (href && variant === "link-row")) && (
				<span class="card__cta" aria-hidden={ctaLabel ? undefined : "true"}>
					{ctaLabel && <span class="card__cta-label">{ctaLabel}</span>}
					<svg class="card__arrow" width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</span>
			)
		}
	</div>
</article>

<style>
	.card {
		--card-fg: var(--section-fg, var(--color-text));
		--card-muted: var(--section-fg-muted, var(--color-text-muted));
		--card-line: var(--section-line, var(--color-line));
		--card-bg: transparent;
		--card-eyebrow: var(--color-brand);
		--card-hover-line: var(--color-brand);
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		min-width: 0;
		color: var(--card-fg);
		background: var(--card-bg);
		border: 1px solid var(--card-line);
		border-radius: var(--radius-card);
		overflow: hidden;
		isolation: isolate;
		transition:
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
			box-shadow 0.35s ease,
			border-color 0.25s ease,
			background 0.25s ease;
	}

	/* ---- Colour tones ---- */
	.card[data-tone="white"] {
		--card-bg: var(--color-paper);
	}

	.card[data-tone="soft"] {
		--card-bg: var(--color-paper-soft);
		--card-line: transparent;
	}

	.card[data-tone="dark"] {
		--card-bg: var(--color-ink);
		--card-fg: var(--color-text-on-ink);
		--card-muted: var(--color-text-on-ink-muted);
		--card-line: var(--color-line-on-ink);
		--card-eyebrow: var(--color-accent);
		--card-hover-line: var(--color-accent);
	}

	.card[data-tone="accent"] {
		--card-bg: var(--color-accent);
		--card-fg: var(--color-accent-ink);
		--card-muted: color-mix(in srgb, var(--color-accent-ink) 72%, transparent);
		--card-line: color-mix(in srgb, var(--color-accent-ink) 22%, transparent);
		--card-eyebrow: var(--color-accent-ink);
		--card-hover-line: var(--color-accent-ink);
	}

	/* ---- Shared parts ---- */
	.card__body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.7rem;
		flex: 1;
		padding: 1.5rem;
	}

	.card__title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.3rem;
		line-height: var(--leading-snug);
		color: var(--card-fg);
	}

	.card__text {
		margin: 0;
		font-size: var(--text-small);
		line-height: var(--leading-normal);
		color: var(--card-muted);
	}

	.card__eyebrow,
	.card__meta,
	.card__number {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.card__eyebrow {
		color: var(--card-eyebrow);
	}

	.card__meta {
		color: var(--card-muted);
	}

	.card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card__tag {
		padding: 0.28rem 0.7rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--card-muted);
		border: 1px solid var(--card-line);
		border-radius: 999px;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.card:hover .card__tag {
		color: var(--card-fg);
		border-color: var(--card-hover-line);
	}

	/* Whole card is the click target via one stretched link. */
	.card__link {
		color: inherit;
		text-decoration: none;
	}

	.card__link::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 2;
	}

	.card__link:focus-visible {
		outline: none;
	}

	.card[data-linked]:has(.card__link:focus-visible) {
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 70%, transparent);
	}

	.card[data-linked] {
		cursor: pointer;
	}

	.card__cta {
		margin-top: auto;
		padding-top: 0.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--text-small);
		font-weight: 600;
		color: var(--card-fg);
	}

	.card__cta-label {
		background: linear-gradient(currentColor, currentColor) left bottom / 0% 1px no-repeat;
		padding-bottom: 2px;
		transition: background-size 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.card:hover .card__cta-label {
		background-size: 100% 1px;
	}

	.card__arrow {
		flex-shrink: 0;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.card:hover .card__arrow {
		transform: translate(3px, -3px);
	}

	/* ---- Media ---- */
	.card__media {
		position: relative;
		overflow: hidden;
	}

	.card__media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.card:hover .card__media :global(img) {
		transform: scale(1.04);
	}

	/* Whole image visible: letterbox on a soft panel instead of cropping. */
	.card--fit-contain .card__media {
		background: var(--color-paper-soft);
	}

	.card--fit-contain .card__media :global(img) {
		object-fit: contain;
	}

	.card__placeholder {
		width: 100%;
		height: 100%;
		background: var(--color-paper-soft);
	}

	/* ---- Hover effect set by the grid: lift | glow | none ---- */
	:global([data-hover="lift"]) .card:not(.card--editorial):not(.card--numbered):not(.card--link-row):hover {
		transform: translateY(-5px);
		border-color: var(--card-hover-line);
		box-shadow: 0 18px 40px rgba(11, 11, 12, 0.12);
	}

	/* Pointer-following light: the grid script sets --mx / --my. */
	:global([data-hover="glow"]) .card:not(.card--editorial):not(.card--numbered):not(.card--link-row)::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		opacity: 0;
		background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--color-accent) 55%, transparent), transparent 70%);
		transition: opacity 0.3s ease;
	}

	:global([data-hover="glow"]) .card:not(.card--editorial):not(.card--numbered):not(.card--link-row):hover::before {
		opacity: 1;
	}

	:global([data-hover="glow"]) .card:not(.card--editorial):not(.card--numbered):not(.card--link-row):hover {
		border-color: var(--card-hover-line);
	}

	/* ---- image-top ---- */
	.card--image-top .card__media {
		aspect-ratio: 16 / 10;
	}

	/* ---- image-left ---- */
	.card--image-left {
		flex-direction: row;
	}

	.card--image-left .card__media {
		flex: 0 0 38%;
		min-height: 100%;
	}

	.card--image-left .card__body {
		padding: 1.75rem;
		justify-content: center;
	}

	@media (max-width: 640px) {
		.card--image-left {
			flex-direction: column;
		}

		.card--image-left .card__media {
			flex-basis: auto;
			aspect-ratio: 16 / 10;
		}
	}

	/* ---- icon ---- */
	.card--icon .card__body {
		padding: 1.75rem;
		gap: 0.85rem;
	}

	.card__icon {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		margin-bottom: 0.4rem;
		border: 1px solid var(--card-line);
		border-radius: 0.75rem;
		color: var(--card-fg);
		transition:
			background 0.3s ease,
			color 0.3s ease,
			border-color 0.3s ease,
			transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.card__icon :global(img) {
		width: 62%;
		height: 62%;
		object-fit: contain;
	}

	.card:hover .card__icon {
		background: var(--color-accent);
		color: var(--color-accent-ink);
		border-color: var(--color-accent);
		transform: rotate(-6deg) scale(1.06);
	}

	/* ---- text ---- */
	.card--text .card__body {
		padding: 1.75rem;
	}

	/* ---- highlight ---- */
	.card--highlight .card__body {
		padding: 2rem;
		gap: 0.9rem;
	}

	.card--highlight .card__title {
		font-size: clamp(1.5rem, 1.25rem + 0.8vw, 1.9rem);
	}

	.card--highlight::after {
		content: "";
		position: absolute;
		top: -3rem;
		right: -3rem;
		width: 11rem;
		height: 11rem;
		border-radius: 50%;
		z-index: -1;
		background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 38%, transparent), transparent 68%);
		transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
		pointer-events: none;
	}

	.card--highlight:hover::after {
		transform: scale(1.35) translate(-0.5rem, 0.5rem);
	}

	/* ---- numbered: open layout, rule on top ---- */
	.card--numbered {
		border: 0;
		border-top: 1px solid var(--card-line);
		border-radius: 0;
		background: transparent;
		overflow: visible;
	}

	.card--numbered .card__body {
		padding: 1.5rem 0 0;
		gap: 0.8rem;
	}

	.card__number {
		font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3.25rem);
		line-height: 1;
		letter-spacing: 0;
		color: transparent;
		-webkit-text-stroke: 1px var(--card-muted);
		transition:
			color 0.35s ease,
			-webkit-text-stroke-color 0.35s ease;
	}

	.card--numbered:hover .card__number {
		color: var(--color-accent);
		-webkit-text-stroke-color: var(--color-accent);
	}

	.card--numbered::before {
		content: "";
		position: absolute;
		top: -1px;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--card-hover-line);
		transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.card--numbered:hover::before {
		width: 100%;
	}

	/* ---- link-row ---- */
	.card--link-row {
		border: 0;
		border-bottom: 1px solid var(--card-line);
		border-radius: 0;
		background: transparent;
		overflow: visible;
	}

	.card--link-row .card__body {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			"eyebrow cta"
			"title cta"
			"text cta";
		align-items: center;
		column-gap: 1.5rem;
		row-gap: 0.3rem;
		padding: 1.4rem 0;
		transition: padding-left 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.card--link-row:hover .card__body {
		padding-left: 0.75rem;
	}

	.card--link-row .card__eyebrow,
	.card--link-row .card__tags,
	.card--link-row .card__meta {
		grid-column: 1;
	}

	.card--link-row .card__title {
		grid-area: title;
	}

	.card--link-row .card__text {
		grid-area: text;
	}

	.card--link-row .card__cta {
		grid-area: cta;
		margin: 0;
		padding: 0;
		align-self: center;
	}

	.card--link-row .card__arrow {
		width: 1.5rem;
		height: 1.5rem;
	}

	/* ---- editorial (blog listing) ---- */
	.card--editorial {
		border: 0;
		border-top: 1px solid var(--card-line);
		border-radius: 0;
		background: transparent;
		overflow: visible;
	}

	.card--editorial .card__media {
		aspect-ratio: 4 / 3;
		margin-top: 1.5rem;
		border-radius: var(--radius-card);
	}

	.card--editorial.card--featured .card__media {
		aspect-ratio: unset;
		height: clamp(14rem, 22vw, 23rem);
	}

	.card--editorial .card__body {
		padding: 1.1rem 0 0;
		gap: 0;
	}

	.card--editorial .card__title {
		font-size: 1.2rem;
		margin: 0 0 0.5rem;
	}

	.card--editorial .card__meta {
		font-family: inherit;
		font-size: var(--text-small);
		letter-spacing: 0;
		text-transform: none;
		color: var(--card-muted);
	}

	.card--editorial .card__meta--top {
		margin-bottom: 0.75rem;
	}

	.card__divider {
		display: block;
		align-self: stretch;
		border-top: 1px solid var(--card-line);
		margin-bottom: 1rem;
	}

	@media (max-width: 900px) {
		.card--editorial.card--featured .card__media {
			aspect-ratio: 4 / 3;
			height: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.card__media :global(img),
		.card__icon,
		.card__arrow,
		.card__cta-label,
		.card--link-row .card__body,
		.card--highlight::after,
		.card--numbered::before {
			transition: none;
		}

		:global([data-hover]) .card:hover {
			transform: none;
		}

		.card:hover .card__media :global(img),
		.card:hover .card__icon,
		.card:hover .card__arrow,
		.card--highlight:hover::after {
			transform: none;
		}
	}
</style>
