---
// "Testimonials" page-layout block. Renders a grid of client testimonials
// from the CMS-managed `items` repeater, optionally capped by the editor's
// `limit` field (stored order is preserved -- limit just slices the head).
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageLayoutBlock } from "../../../emdash-env";

type TestimonialsBlock = Extract<PageLayoutBlock, { _type: "testimonials" }>;
type Props = BlockComponentProps<TestimonialsBlock>;

const { value } = Astro.props;

const allItems = value.items ?? [];
const items = value.limit ? allItems.slice(0, value.limit) : allItems;
---

{
	items.length > 0 && (
		<section class="testimonials-block">
			<div class="testimonials-block__inner">
				{value.heading && <h2 class="testimonials-block__heading">{value.heading}</h2>}

				<ul class="testimonials-block__grid">
					{items.map((item) => (
						<li class="testimonials-block__card">
							<p class="testimonials-block__quote">&ldquo;{item.testimonial_text}&rdquo;</p>
							<div class="testimonials-block__byline">
								{item.person_image ? (
									<span class="testimonials-block__avatar">
										<Image image={item.person_image} alt={item.person_name} class="testimonials-block__avatar-img" />
									</span>
								) : (
									<span class="testimonials-block__avatar testimonials-block__avatar--fallback" aria-hidden="true">
										{item.person_name.charAt(0)}
									</span>
								)}
								<div class="testimonials-block__meta">
									<span class="testimonials-block__name">{item.person_name}</span>
									<span class="testimonials-block__role">
										{item.person_title && `${item.person_title}, `}
										{item.company_url ? (
											<a
												class="testimonials-block__company-link"
												href={sanitizeHref(item.company_url)}
												target="_blank"
												rel="noopener noreferrer"
											>
												{item.company}
											</a>
										) : (
											item.company
										)}
									</span>
								</div>
							</div>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.testimonials-block {
		padding: var(--section-pad-y) var(--gutter);
		border-bottom: 1px solid var(--color-line);
	}

	.testimonials-block__inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.testimonials-block__heading {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-h2);
		line-height: var(--leading-tight);
		margin: 0 0 1.5rem;
	}

	.testimonials-block__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--color-line);
		border: 1px solid var(--color-line);
	}

	.testimonials-block__card {
		background: var(--color-paper);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 16rem;
	}

	.testimonials-block__quote {
		font-family: var(--font-display);
		font-size: 1.15rem;
		line-height: var(--leading-snug);
		color: var(--color-text);
		margin: 0 0 1.5rem;
	}

	.testimonials-block__byline {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.testimonials-block__avatar {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 999px;
		overflow: hidden;
		flex-shrink: 0;
	}

	.testimonials-block__avatar :global(.testimonials-block__avatar-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.testimonials-block__avatar--fallback {
		background: var(--color-accent);
		color: var(--color-accent-ink);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: var(--text-small);
	}

	.testimonials-block__meta {
		display: flex;
		flex-direction: column;
	}

	.testimonials-block__name {
		font-size: var(--text-small);
		font-weight: 600;
		color: var(--color-text);
	}

	.testimonials-block__role {
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	.testimonials-block__company-link {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	@media (max-width: 780px) {
		.testimonials-block__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
